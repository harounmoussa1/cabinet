{
    "name": "dental-cab-manager",
    "private": true,
    "version": "1.0.0",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "rimraf dist dist-electron && tsc && vite build && electron-builder",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5173 && electron .\"",
        "postinstall": "electron-builder install-app-deps"
    },
    "dependencies": {
        "adm-zip": "^0.5.16",
        "archiver": "^7.0.1",
        "better-sqlite3": "^11.0.0",
        "clsx": "^2.1.0",
        "date-fns": "^3.0.0",
        "googleapis": "^170.1.0",
        "lucide-react": "^0.300.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.0",
        "tailwind-merge": "^2.2.0"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.7",
        "@types/archiver": "^7.0.0",
        "@types/better-sqlite3": "^7.6.0",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^28.1.0",
        "electron-builder": "^26.4.0",
        "eslint": "^8.55.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "postcss": "^8.4.32",
        "rimraf": "^6.1.2",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.2.2",
        "vite": "^5.0.8",
        "vite-plugin-electron": "^0.28.0",
        "vite-plugin-electron-renderer": "^0.14.5",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.dentalcab.manager",
        "productName": "DentalCab Manager",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist",
            "dist-electron",
            "client_secret_563280144828-jr8o0jt5u3r4ju8nrt9hcl56qfr78td4.apps.googleusercontent.com.json"
        ],
        "asar": true,
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "DentalCab Manager"
        }
    }
}